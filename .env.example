# ==============================================================================
# PROJECTFLOW INTELLIGENCE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development with real credentials
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO

# Supabase Managed Database (PostgreSQL)
# For local dev without Supabase, backend automatically falls back to embedded H2 PostgreSQL mode
SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# Supabase Authentication & Security
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend (Admin Panel) Configuration (Vite prefix VITE_)
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
