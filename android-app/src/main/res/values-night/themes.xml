<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Mode Theme with Natural Mineral Charcoal & Deep Sage -->
    <style name="Theme.ProjectFlow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/mineral_sage</item>
        <item name="colorPrimaryVariant">@color/deep_sage</item>
        <item name="colorOnPrimary">@color/chalk_white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/forest_green</item>
        <item name="colorSecondaryVariant">@color/deep_sage_dark</item>
        <item name="colorOnSecondary">@color/chalk_white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
    </style>
</resources>
