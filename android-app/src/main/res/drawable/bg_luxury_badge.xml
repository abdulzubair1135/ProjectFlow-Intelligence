<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Drop Shadow -->
    <item
        android:left="2dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neu_shadow_deep" />
        </shape>
    </item>

    <!-- Soft Diffused Shadow -->
    <item
        android:left="1dp"
        android:top="1.5dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neu_shadow_soft" />
        </shape>
    </item>

    <!-- Top-Left Crest Highlight -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/neu_highlight" />
        </shape>
    </item>

    <!-- Elevated Luxury Surface Plate -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp" />
            <solid android:color="@color/earth_surface" />
            <stroke
                android:width="1.2dp"
                android:color="#4047745A" />
        </shape>
    </item>
</layer-list>
