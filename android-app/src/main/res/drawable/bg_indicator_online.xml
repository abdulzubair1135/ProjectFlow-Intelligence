<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glowing Outer Halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3347745A" />
            <size android:width="10dp" android:height="10dp" />
        </shape>
    </item>
    <!-- Core Jade Dot -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="oval">
            <solid android:color="@color/chart_done" />
        </shape>
    </item>
</layer-list>
