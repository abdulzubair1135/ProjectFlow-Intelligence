<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom-right soft dark shadow -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/neu_shadow_deep" />
        </shape>
    </item>

    <!-- Top-left subtle highlight -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/neu_highlight" />
        </shape>
    </item>

    <!-- Main surface plate -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="@color/earth_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/earth_border" />
        </shape>
    </item>
</layer-list>
