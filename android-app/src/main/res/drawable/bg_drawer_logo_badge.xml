<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Drop Shadow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/neu_shadow_deep" />
        </shape>
    </item>
    <!-- Highlight Edge -->
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="2dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="@color/neu_highlight" />
        </shape>
    </item>
    <!-- Raised Surface -->
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="3dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/neu_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_border" />
        </shape>
    </item>
</layer-list>
