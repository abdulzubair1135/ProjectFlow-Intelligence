<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow Bevel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/neu_shadow_soft" />
        </shape>
    </item>
    <!-- Raised/Beveled Surface -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@color/neu_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/neu_border" />
        </shape>
    </item>
</layer-list>
