<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Avatar with Online / Group Emblem -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <LinearLayout
            android:id="@+id/layoutConversationAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_neu_circle"
            android:gravity="center">

            <TextView
                android:id="@+id/tvConversationInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PF"
                android:textColor="@color/primary_earth"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivGroupIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_team"
                android:visibility="gone"
                app:tint="@color/primary_earth" />
        </LinearLayout>

        <!-- Green Online Dot for 1-on-1 chats -->
        <View
            android:id="@+id/viewOnlineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_dot_done" />
    </FrameLayout>

    <!-- Title and Last Message snippet -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConversationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rahul Verma"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConversationSnippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hey, checking in on the sprint delivery..."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Timestamp & Type Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvConversationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:45 PM"
            android:textColor="@color/text_muted"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/tvConversationTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_neu_pill"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="1-on-1"
            android:textColor="@color/primary_earth"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
