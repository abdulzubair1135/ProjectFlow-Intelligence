<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/limestone_ivory"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <!-- Filter Tabs (All, Unread) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabNotifAll"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@color/deep_sage"
            android:gravity="center"
            android:text="@string/tab_all"
            android:textColor="@color/chalk_white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabNotifUnread"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@color/chalk_white"
            android:gravity="center"
            android:text="@string/tab_unread"
            android:textColor="@color/charcoal"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Notifications List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/notificationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Notification 1 -->
            <include layout="@layout/item_notification" />

            <!-- Notification 2 -->
            <include layout="@layout/item_notification" />

            <!-- Notification 3 -->
            <include layout="@layout/item_notification" />

            <!-- Notification 4 -->
            <include layout="@layout/item_notification" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
