<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Sender Avatar Circle -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_chip_selected">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="U"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <!-- Sender Header: Name + Role Badge + Time -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Administrator"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSenderRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="MEMBER"
                android:textColor="@color/primary_earth"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="10:30 AM"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 3D Speech Bubble -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_neu_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvMessageContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="Message body..."
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:text="10:30 AM"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Interactive Emoji Reactions Bar -->
        <LinearLayout
            android:id="@+id/llReactions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReactLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_neu_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="👍 0"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnReactRocket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_neu_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="🚀 0"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnReactFire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_neu_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="🔥 0"
                android:textColor="@color/text_main"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnReactLove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_neu_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="❤️ 0"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
