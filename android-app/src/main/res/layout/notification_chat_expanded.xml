<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootNotifExpanded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Header Row: Brand Logo, App & Channel Tag, Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Brand Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_clean" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ProjectFlow"
            android:textColor="#8C8072"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#B0A695"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notifChannelExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#47745A"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/notifTimeExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8C8072"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Signature Limestone Ivory Card with Dark Espresso Text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_notif_bubble"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/notifSenderExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#261E17"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notifMessageExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#403328"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
