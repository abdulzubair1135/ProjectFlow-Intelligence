<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/limestone_ivory"
    android:padding="24dp">

    <!-- Top Skip Action -->
    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:background="?android:attr/selectableItemBackground"
        android:padding="8dp"
        android:text="@string/skip"
        android:textColor="@color/stone_grey"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Center Card / Illustration Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Visual Badge / Illustration Container -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="@drawable/ic_projects"
            android:backgroundTint="@color/mineral_sage" />

        <TextView
            android:id="@+id/tvOnboardingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/app_tagline"
            android:textColor="@color/charcoal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOnboardingDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/onboarding_subtitle"
            android:textColor="@color/stone_grey"
            android:textSize="14sp" />

        <!-- Pager Dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <View
                android:layout_width="16dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/deep_sage" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="6dp"
                android:background="@color/mineral_grey" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/mineral_grey" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Button -->
    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/deep_sage"
        android:text="@string/get_started"
        android:textColor="@color/chalk_white"
        android:textSize="15sp"
        android:textStyle="bold" />

</RelativeLayout>
