<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="5dp">

    <!-- 3D Outgoing Bubble -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:background="@drawable/bg_button_earth"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="My message body..."
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="10:32 AM"
            android:textColor="@color/secondary_sand"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Outgoing Reaction Counters -->
    <LinearLayout
        android:id="@+id/llReactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReactLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neu_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="👍 0"
            android:textColor="@color/text_main"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnReactRocket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_neu_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="🚀 0"
            android:textColor="@color/text_main"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnReactFire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_neu_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="🔥 0"
            android:textColor="@color/text_main"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
