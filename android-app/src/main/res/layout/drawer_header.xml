<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="185dp"
    android:background="@drawable/bg_drawer_header_gradient">

    <!-- Organic Flowing Leaf & Stream Background Animation -->
    <com.projectflow.android.ui.view.FlowLeafHeaderView
        android:id="@+id/drawerLeafHeader"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 3D Neumorphic Logo Badge with clean transparent emblem -->
        <LinearLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_drawer_logo_badge"
            android:gravity="center"
            android:padding="9dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/brand_name"
                android:src="@drawable/logo_clean" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.015"
            android:text="@string/brand_name"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Workspace: Engineering &amp; Innovation"
            android:textColor="@color/secondary_sand"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
